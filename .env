# Primary database (Neon PostgreSQL)
DATABASE_URL="postgresql://neondb_owner:npg_3hFZoSJni0mb@ep-still-dew-a153jnuy-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# ---- AI provider switches (for offline college deployment) ----
# LLM: "zai" (managed demo) | "ollama" (fully offline)
AI_PROVIDER=zai
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma2:9b

# ASR: "zai" (managed demo) | "whisper" (whisper.cpp server, fully offline)
ASR_PROVIDER=zai
WHISPER_URL=http://127.0.0.1:8080

# TTS: "zai" (managed demo) | "piper" (piper-http server, fully offline)
TTS_PROVIDER=zai
PIPER_URL=http://127.0.0.1:8081
PIPER_EN_VOICE=en_GB-alan-medium
PIPER_TA_VOICE=ta_IN-va_swara-medium
